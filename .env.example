# Runtime
REPWISE_ENV=development
REPWISE_LOG_LEVEL=INFO
REPWISE_DATABASE_URL=postgresql+psycopg://repwise:change-me@127.0.0.1:55432/repwise
REPWISE_REDIS_URL=redis://127.0.0.1:56379/0
REPWISE_MEDIA_ENDPOINT=http://127.0.0.1:59000
REPWISE_MEDIA_BUCKET=repwise-private
REPWISE_POSTGRES_PASSWORD=change-me
REPWISE_MEDIA_ACCESS_KEY=repwise-local
REPWISE_MEDIA_SECRET_KEY=change-me-now
REPWISE_WEB_ORIGIN=http://127.0.0.1:5173

# Browser-facing API origin. This value is safe to expose to the web client.
VITE_API_URL=http://127.0.0.1:8010
# Proof-stage local identity only; replaced by secure sessions before private alpha.
VITE_INTERNAL_USER_ID=10000000-0000-0000-0000-000000000001
REPWISE_API_PORT=8010
REPWISE_BETA_MONTHLY_ANALYSIS_QUOTA=30
REPWISE_BETA_DAILY_ANALYSIS_QUOTA=5
# Must remain false until a reviewed payment integration is introduced.
REPWISE_PAYMENTS_ENABLED=false

# Add database, queue, media-store, identity and monitoring settings only in
# the pull request that introduces each dependency. Never commit real secrets.
