# Copy to .env.portable or run ./scripts/repwise setup to generate secrets.
REPWISE_PUBLIC_HOST=127.0.0.1
REPWISE_BIND_ADDRESS=127.0.0.1
REPWISE_WEB_PORT=8180
REPWISE_MEDIA_PORT=59000
REPWISE_MEDIA_CONSOLE_PORT=59001
REPWISE_INTERNAL_USER_ID=10000000-0000-0000-0000-000000000001
REPWISE_POSTGRES_PASSWORD=replace-with-a-random-value
REPWISE_MEDIA_ACCESS_KEY=repwise-local
REPWISE_MEDIA_SECRET_KEY=replace-with-a-random-value
REPWISE_AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
REPWISE_IDENTITY_ASSERTION_SECRET=replace-with-at-least-32-random-characters
