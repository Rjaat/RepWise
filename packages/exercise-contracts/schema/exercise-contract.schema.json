{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repwise.app/schemas/exercise-contract/1.0.0",
  "title": "RepWise exercise assessment contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "contract_version", "exercise", "variant", "view", "pose_schema", "required_landmarks", "view_constraints", "minimum_observation", "phase_states", "thresholds", "supported_checks", "unavailable_checks", "explanation_templates", "validation"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"},
    "contract_version": {"type": "integer", "minimum": 1},
    "exercise": {"type": "string"}, "variant": {"type": "string"}, "view": {"type": "string"},
    "pose_schema": {"const": "mediapipe_pose_33@1"},
    "required_landmarks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "view_constraints": {"type": "object"}, "minimum_observation": {"type": "object"},
    "phase_states": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "thresholds": {"type": "object", "minProperties": 1},
    "supported_checks": {"type": "array", "minItems": 1},
    "unavailable_checks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "explanation_templates": {"type": "object"}, "validation": {"type": "object"}
  }
}
